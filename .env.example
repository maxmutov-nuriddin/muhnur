# Copy to .env for local dev. On Netlify set these under
# Site configuration > Environment variables (scope: Functions).

# Server-only (read by netlify/functions/contact.mjs). Never prefix with VITE_.
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Chat that receives form messages: your user id or a group id (from @userinfobot).
TELEGRAM_CHAT_ID=

# Client-side (bundled into the site, must not hold secrets).
# Optional: override the contact endpoint. Default: /api/contact
VITE_CONTACT_ENDPOINT=
